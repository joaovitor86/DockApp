<Window x:Class="DockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:DockApp.Models"
        Title="Dock"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="Manual">

    <!--
        Container principal da Dock.

        Padding, Background, BorderBrush, BorderThickness, CornerRadius
        e Effect (sombra) NÃO são definidos aqui: são 100% controlados
        pelo método ApplyAppearance() em MainWindow.xaml.cs, a partir
        das configurações salvas em DockSettings.
    -->
    <Grid>
    <Border x:Name="DockBorder" ContextMenuOpening="DockMenu_Opening">

        <!--
            Menu de contexto da Dock.
        -->
        <Border.ContextMenu>

            <ContextMenu>
                <MenuItem x:Name="AddSeparatorMenu" Header="Adicionar separador" Click="AddSeparator_Click"/>
                <MenuItem x:Name="RemoveSeparatorMenu" Header="Remover separador" Click="RemoveSeparator_Click" Visibility="Collapsed"/>
                <Separator/>

                <MenuItem Header="Configurações..."
                          Click="OpenSettings_Click"/>

                <Separator/>

                <MenuItem Header="Ocultar Dock"
                          Click="HideMenuItem_Click"/>

            </ContextMenu>

        </Border.ContextMenu>

        <!--
            Lista de ícones.

            O ItemsPanel e o ItemContainerStyle (responsável pelo
            espaçamento entre ícones, via IconSpacing) são definidos
            dinamicamente no MainWindow.xaml.cs, dentro de ApplyLayout(),
            para permitir que a Dock fique horizontal ou vertical
            dependendo da posição, e que o espaçamento seja configurável.
        -->
        <Grid>
            <Button Panel.ZIndex="1" Content="Adicionar itens…" Padding="8,4" Click="OpenSettings_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=IconsPanel, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ItemsControl x:Name="IconsPanel">

                <ItemsControl.Resources>

                    <DataTemplate DataType="{x:Type models:DockSeparator}">
                        <Grid Background="Transparent" Width="12"
                              Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                              Tag="{Binding}" Cursor="SizeAll" AutomationProperties.Name="Separador"
                              LayoutTransform="{DynamicResource SeparatorRotation}"
                              MouseLeftButtonDown="Icon_Press" MouseMove="Icon_DragMove" MouseLeftButtonUp="Icon_Click"
                              AllowDrop="True" DragOver="Icon_DragOver" DragLeave="Icon_DragLeave" Drop="Icon_Drop">
                            <Border Width="2" Margin="0,4" CornerRadius="1" Opacity="0.85"
                                    Background="{DynamicResource SeparatorBrush}"/>
                            <Border x:Name="DropOutline" Visibility="Collapsed" IsHitTestVisible="False"
                                    BorderThickness="1" BorderBrush="White" CornerRadius="3"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type models:DockItem}">

                        <!--
                            Ícone individual da Dock.

                            IMPORTANTE:
                            O RenderTransform é definido AQUI, diretamente
                            no elemento, e não em um Style compartilhado.

                            Um Style compartilhado entre vários ícones é
                            selado ("frozen") pelo WPF por performance, o
                            que impede chamar BeginAnimation() diretamente
                            em código (gera InvalidOperationException:
                            "o objeto está selado ou congelado").

                            Como o RenderTransform é declarado aqui dentro
                            do DataTemplate, cada ícone gerado recebe sua
                            própria instância de TransformGroup, isolada
                            das demais, permitindo animar livremente tanto
                            o "quique" de lançamento (PlayLaunchBounce)
                            quanto o zoom de hover (Icon_MouseEnter/Leave),
                            ambos em MainWindow.xaml.cs.

                            Source:
                                Recebe DockItem.Icon.

                            Width/Height:
                                Recebem o tamanho configurado
                                na MainWindow.

                            Tag:
                                Guarda o próprio DockItem para
                                ser recuperado pelo evento Icon_Click.

                            MouseEnter/MouseLeave:
                                Disparam a animação de zoom no hover,
                                cuja intensidade vem de DockSettings.HoverScale.
                        -->
                        <Grid Background="Transparent"
                               Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="0.5,0.5"
                               Cursor="Hand"
                               Tag="{Binding}"
                               MouseLeftButtonDown="Icon_Press"
                               MouseMove="Icon_DragMove"
                               AllowDrop="True"
                               DragOver="Icon_DragOver"
                               DragLeave="Icon_DragLeave"
                               Drop="Icon_Drop"
                               MouseLeftButtonUp="Icon_Click"
                               MouseEnter="Icon_MouseEnter"
                               MouseLeave="Icon_MouseLeave">

                            <Grid.RenderTransform>

                                <TransformGroup>

                                    <!-- Escala utilizada pelo efeito de hover. -->
                                    <ScaleTransform ScaleX="1"
                                                    ScaleY="1"/>

                                    <!--
                                        Deslocamento utilizado pelo efeito
                                        de lançamento do aplicativo.
                                    -->
                                    <TranslateTransform X="0"
                                                          Y="0"/>
                                    <ScaleTransform/>
                                    <RotateTransform/>

                                </TransformGroup>

                            </Grid.RenderTransform>
                            <TextBlock Text="◆" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Image Source="{Binding Icon}"/>
                            <Ellipse Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                     Fill="#73E8AF" Stroke="#182920" StrokeThickness="1" IsHitTestVisible="False">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Border x:Name="DropOutline" Visibility="Collapsed" IsHitTestVisible="False"
                                    BorderThickness="2" BorderBrush="White" CornerRadius="5"/>

                        </Grid>

                    </DataTemplate>

                </ItemsControl.Resources>

            </ItemsControl>
        </Grid>

    </Border>
    </Grid>

</Window>
