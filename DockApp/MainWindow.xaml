<Window x:Class="DockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!--
        Container principal da Dock.

        Padding, Background, BorderBrush, BorderThickness, CornerRadius
        e Effect (sombra) NÃO são definidos aqui: são 100% controlados
        pelo método ApplyAppearance() em MainWindow.xaml.cs, a partir
        das configurações salvas em DockSettings.
    -->
    <Border x:Name="DockBorder"
            ContextMenuOpening="Border_ContextMenuOpening">

        <!--
            Menu de contexto da Dock.
        -->
        <Border.ContextMenu>

            <ContextMenu>

                <MenuItem Header="Configurações..."
                          Click="OpenSettings_Click"/>

                <Separator/>

                <MenuItem Header="Ocultar Dock"
                          Click="HideMenuItem_Click"/>

            </ContextMenu>

        </Border.ContextMenu>

        <!--
            Lista de ícones.

            O ItemsPanel e o ItemContainerStyle (responsável pelo
            espaçamento entre ícones, via IconSpacing) são definidos
            dinamicamente no MainWindow.xaml.cs, dentro de ApplyLayout(),
            para permitir que a Dock fique horizontal ou vertical
            dependendo da posição, e que o espaçamento seja configurável.
        -->
        <ItemsControl x:Name="IconsPanel">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <!--
                        Ícone individual da Dock.

                        IMPORTANTE:
                        O RenderTransform é definido AQUI, diretamente
                        no elemento, e não em um Style compartilhado.

                        Um Style compartilhado entre vários ícones é
                        selado ("frozen") pelo WPF por performance, o
                        que impede chamar BeginAnimation() diretamente
                        em código (gera InvalidOperationException:
                        "o objeto está selado ou congelado").

                        Como o RenderTransform é declarado aqui dentro
                        do DataTemplate, cada ícone gerado recebe sua
                        própria instância de TransformGroup, isolada
                        das demais, permitindo animar livremente tanto
                        o "quique" de lançamento (PlayLaunchBounce)
                        quanto o zoom de hover (Icon_MouseEnter/Leave),
                        ambos em MainWindow.xaml.cs.

                        Source:
                            Recebe DockItem.Icon.

                        Width/Height:
                            Recebem o tamanho configurado
                            na MainWindow.

                        Tag:
                            Guarda o próprio DockItem para
                            ser recuperado pelo evento Icon_Click.

                        MouseEnter/MouseLeave:
                            Disparam a animação de zoom no hover,
                            cuja intensidade vem de DockSettings.HoverScale.
                    -->
                    <Image Source="{Binding Icon}"
                           Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderTransformOrigin="0.5,0.5"
                           Cursor="Hand"
                           ToolTip="{Binding Name}"
                           Tag="{Binding}"
                           MouseLeftButtonUp="Icon_Click"
                           MouseEnter="Icon_MouseEnter"
                           MouseLeave="Icon_MouseLeave">

                        <Image.RenderTransform>

                            <TransformGroup>

                                <!-- Escala utilizada pelo efeito de hover. -->
                                <ScaleTransform ScaleX="1"
                                                ScaleY="1"/>

                                <!--
                                    Deslocamento utilizado pelo efeito
                                    de lançamento do aplicativo.
                                -->
                                <TranslateTransform X="0"
                                                      Y="0"/>

                            </TransformGroup>

                        </Image.RenderTransform>

                    </Image>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Border>

</Window>