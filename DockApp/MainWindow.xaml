<Window x:Class="DockApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dock"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">

    <!--
        Recursos visuais da janela principal.
        Aqui ficam os estilos utilizados pelos ícones da Dock.
    -->
    <Window.Resources>

        <!--
            Estilo dos ícones da Dock.

            O TransformGroup possui:
            1. ScaleTransform     -> aumenta/diminui o ícone.
            2. TranslateTransform -> permite o efeito de "quique"
               quando o programa é aberto.
        -->
        <Style x:Key="DockIconStyle"
               TargetType="Image">

            <!--
                Define o centro do próprio ícone como origem
                das transformações.
            -->
            <Setter Property="RenderTransformOrigin"
                    Value="0.5,0.5"/>

            <!-- Grupo de transformações utilizado pelo código C#. -->
            <Setter Property="RenderTransform">

                <Setter.Value>

                    <TransformGroup>

                        <!-- Escala utilizada pelo efeito de hover. -->
                        <ScaleTransform ScaleX="1"
                                        ScaleY="1"/>

                        <!--
                            Deslocamento utilizado pelo efeito
                            de lançamento do aplicativo.
                        -->
                        <TranslateTransform X="0"
                                              Y="0"/>

                    </TransformGroup>

                </Setter.Value>

            </Setter>

            <!--
                Eventos visuais relacionados ao mouse sobre o ícone.
            -->
            <Style.Triggers>

                <Trigger Property="IsMouseOver"
                         Value="True">

                    <!-- Animação ao entrar com o mouse. -->
                    <Trigger.EnterActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                    To="1.4"
                                    Duration="0:0:0.12"/>

                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                    To="1.4"
                                    Duration="0:0:0.12"/>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.EnterActions>

                    <!-- Animação ao retirar o mouse. -->
                    <Trigger.ExitActions>

                        <BeginStoryboard>

                            <Storyboard>

                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleX"
                                    To="1"
                                    Duration="0:0:0.12"/>

                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Children[0].ScaleY"
                                    To="1"
                                    Duration="0:0:0.12"/>

                            </Storyboard>

                        </BeginStoryboard>

                    </Trigger.ExitActions>

                </Trigger>

            </Style.Triggers>

        </Style>

    </Window.Resources>

    <!--
        Container principal da Dock.
    -->
    <Border x:Name="DockBorder"
            Padding="20"
            ContextMenuOpening="Border_ContextMenuOpening">

        <!--
            Menu de contexto da Dock.
        -->
        <Border.ContextMenu>

            <ContextMenu>

                <MenuItem Header="Configurações..."
                          Click="OpenSettings_Click"/>

                <Separator/>

                <MenuItem Header="Ocultar Dock"
                          Click="HideMenuItem_Click"/>

            </ContextMenu>

        </Border.ContextMenu>

        <!--
            Lista de ícones.

            O ItemsPanel é definido dinamicamente no
            MainWindow.xaml.cs para permitir que a Dock
            fique horizontal ou vertical dependendo da posição.
        -->
        <ItemsControl x:Name="IconsPanel">

            <ItemsControl.ItemTemplate>

                <DataTemplate>

                    <!--
                        Ícone individual da Dock.

                        Source:
                            Recebe DockItem.Icon.

                        Width/Height:
                            Recebem o tamanho configurado
                            na MainWindow.

                        Tag:
                            Guarda o próprio DockItem para
                            ser recuperado pelo evento Icon_Click.
                    -->
                    <Image Source="{Binding Icon}"
                           Width="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Height="{Binding IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                           Margin="6"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource DockIconStyle}"
                           Cursor="Hand"
                           ToolTip="{Binding Name}"
                           Tag="{Binding}"
                           MouseLeftButtonUp="Icon_Click"/>

                </DataTemplate>

            </ItemsControl.ItemTemplate>

        </ItemsControl>

    </Border>

</Window>