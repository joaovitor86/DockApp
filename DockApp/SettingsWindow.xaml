<Window x:Class="DockApp.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Configurações" Width="850" Height="650" MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}" MinWidth="570" MinHeight="390" MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}" WindowStartupLocation="CenterScreen" Background="#0B0C0E" Foreground="#F2F2F2" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- ============================================================
             CORES / BRUSHES
             ============================================================ -->
        <SolidColorBrush x:Key="CardBrush" Color="#1A1C21" />
        <SolidColorBrush x:Key="InputBrush" Color="#121417" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2D34" />
        <SolidColorBrush x:Key="InputBorderBrush" Color="#30343B" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#969BA5" />
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0C0E" Offset="0" />
            <GradientStop Color="#15121C" Offset="0.5" />
            <GradientStop Color="#0B0C0E" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0" />
            <GradientStop Color="#2563EB" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0" />
            <GradientStop Color="#3B82F6" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="AccentSolidBrush" Color="#7C3AED" />
        <SolidColorBrush x:Key="IconTeal" Color="#22D3EE" />
        <SolidColorBrush x:Key="IconPink" Color="#EC4899" />
        <SolidColorBrush x:Key="IconBlue" Color="#3B82F6" />
        <!-- Efeitos de glow do botão primário como recursos (evita nomear Effect dentro de Trigger) -->
        <DropShadowEffect x:Key="ButtonGlowOff" Color="#7C3AED" BlurRadius="0" ShadowDepth="0" Opacity="0.7" />
        <DropShadowEffect x:Key="ButtonGlowOn" Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.85" />
        <!-- ============================================================
             ÍCONES (Segoe Fluent Icons / Segoe MDL2 Assets)
             ============================================================ -->
        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- ============================================================
             TÍTULOS / TEXTOS
             ============================================================ -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- ============================================================
             TEXTBOX
             ============================================================ -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4F58" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSolidBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ============================================================
             THUMB DO SLIDER (bolinha com brilho, cresce no hover/clique)
             ============================================================ -->
        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid x:Name="ThumbRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Ellipse Fill="{StaticResource AccentGradientBrush}" Stroke="#FFFFFF" StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="0" Opacity="0.85" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.3" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.3" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.05" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.05" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Height" Value="6" />
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackFill}">
            <Setter Property="Background" Value="#24272D" />
        </Style>
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================
             BOTÕES (com escala no clique e glow no hover)
             ============================================================ -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Background" Value="#25282D" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="#363A42" BorderThickness="1" CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2F333A" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4A4F58" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Border x:Name="Bg" Background="{StaticResource AccentGradientBrush}" CornerRadius="9" Effect="{StaticResource ButtonGlowOff}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientHoverBrush}" />
                                <Setter TargetName="Bg" Property="Effect" Value="{StaticResource ButtonGlowOn}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================
             COMBOBOX
             ============================================================ -->
        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="Background" Value="#191B1F" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E3239" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="Foreground" Value="#F2F2F2" />
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1.4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4F58" />
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSolidBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- ============================================================
             TOGGLE SWITCH (substitui o CheckBox padrão)
             ============================================================ -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" HorizontalAlignment="Left">
                            <Border x:Name="Track" CornerRadius="13" Background="#30343B" BorderBrush="#3E434C" BorderThickness="1" />
                            <Border x:Name="Thumb" Width="20" Height="20" CornerRadius="10" Background="#C7CAD1" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4" />
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#565B65" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#7C3AED" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#30343B" Duration="0:0:0.15" />
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#C7CAD1" Duration="0:0:0.15" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============================================================
             CARD (borda que "acende" com a cor do tema ao passar o mouse)
             ============================================================ -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Configurações da dock" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TabControl x:Name="SettingsTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Foreground="#F2F2F2">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="#ADB0BB" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Tab" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="14,9">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="White" />
                                        <Setter TargetName="Tab" Property="BorderBrush" Value="#AA91FF" />
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="#252330" />
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="Tab" Property="Background" Value="#353046" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem Header="Itens">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Itens fixados" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <TextBlock Text="Arraste arquivos para a lista. Clique duas vezes no nome para editá-lo." Style="{StaticResource DescriptionText}" Margin="0,0,0,12" />
                                <WrapPanel Margin="0,0,0,8">
                                    <Button Content="Adicionar arquivos…" Click="AddFiles_Click" Width="148" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" />
                                    <Button Content="Adicionar pasta…" Click="AddFolder_Click" Width="132" Style="{StaticResource SecondaryButton}" />
                                </WrapPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <Button Content="Adicionar link" Click="AddLink_Click" Width="120" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                    <TextBox x:Name="LinkInput" Style="{StaticResource ModernTextBox}" ToolTip="Endereço de site ou jogo" AutomationProperties.Name="Endereço de site ou jogo" />
                                </DockPanel>
                                <DataGrid x:Name="ItemsGrid" Height="168" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Single" SelectionUnit="FullRow" AllowDrop="True" PreviewDragOver="Grid_DragOver" Drop="Grid_Drop" Background="#14161B" Foreground="#F2F2F2" RowBackground="#1B1D23" AlternatingRowBackground="#202329" GridLinesVisibility="None" HeadersVisibility="Column" RowHeight="30" BorderBrush="#393D46">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#292C34" />
                                            <Setter Property="Foreground" Value="#D8D9DE" />
                                            <Setter Property="Padding" Value="6" />
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Nome" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="2*" />
                                        <DataGridTextColumn Header="Arquivo ou link" Binding="{Binding Path, Mode=OneWay}" IsReadOnly="True" Width="3*" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <WrapPanel Margin="0,8,0,0">
                                    <Button Content="Subir" Click="MoveUp_Click" Width="65" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" />
                                    <Button Content="Descer" Click="MoveDown_Click" Width="65" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" />
                                    <Button Content="Escolher ícone…" Click="SetIcon_Click" Width="127" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" />
                                    <Button Content="Ícone original" Click="ClearIcon_Click" Width="110" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" />
                                    <Button Content="Desafixar" Click="Remove_Click" Width="87" Style="{StaticResource SecondaryButton}" Margin="0,0,6,4" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Pasta monitorada" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <TextBlock Text="Atalhos desta pasta também aparecem na dock." Style="{StaticResource DescriptionText}" Margin="0,0,0,8" />
                                <DockPanel>
                                    <Button Content="Procurar…" Click="BrowseFolder_Click" Width="105" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                    <TextBox x:Name="FolderTextBox" Style="{StaticResource ModernTextBox}" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Aparência">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,6,0">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="Perfis de cor e movimento" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                <UniformGrid Columns="3">
                                    <Button Tag="Graphite" Click="ApplyProfile_Click" Cursor="Hand" Margin="0,0,8,0" Height="54" AutomationProperties.Name="Grafite">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Tile" CornerRadius="8" BorderBrush="#5D5E67" BorderThickness="1" Padding="12,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#424751" Offset="0" />
                                                            <GradientStop Color="#17181A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="Grafite" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Tag="Aurora" Click="ApplyProfile_Click" Cursor="Hand" Margin="0,0,8,0" Height="54" AutomationProperties.Name="Aurora">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Tile" CornerRadius="8" BorderBrush="#5D5E67" BorderThickness="1" Padding="12,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#236373" Offset="0" />
                                                            <GradientStop Color="#513F76" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="Aurora" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Tag="Amber" Click="ApplyProfile_Click" Cursor="Hand" Margin="0,0,8,0" Height="54" AutomationProperties.Name="Âmbar">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Tile" CornerRadius="8" BorderBrush="#5D5E67" BorderThickness="1" Padding="12,0">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#774830" Offset="0" />
                                                            <GradientStop Color="#48343A" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <TextBlock Text="Âmbar" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Tile" Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Fundo" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <TextBlock Text="Cor principal" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <DockPanel Margin="0,0,0,10">
                                            <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="#63636E" MouseLeftButtonDown="ColorPreview_Click" Cursor="Hand" ToolTip="Escolher cor" />
                                            <TextBox x:Name="ColorTextBox" Style="{StaticResource ModernTextBox}" TextChanged="ColorTextBox_TextChanged" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Opacidade do fundo" />
                                        </DockPanel>
                                        <Slider x:Name="OpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" ValueChanged="OpacitySlider_ValueChanged" />
                                        <DockPanel Margin="0,3,0,13">
                                            <CheckBox x:Name="UseGradientCheckBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Usar degradê" />
                                            <TextBlock Text="Usar degradê" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Segunda cor" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <DockPanel Margin="0,0,0,10">
                                            <Border x:Name="ColorPreview2" DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="#63636E" MouseLeftButtonDown="ColorPreview2_Click" Cursor="Hand" ToolTip="Escolher cor" />
                                            <TextBox x:Name="ColorTextBox2" Style="{StaticResource ModernTextBox}" TextChanged="ColorTextBox2_TextChanged" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=GradientAngleSlider, Path=Value, StringFormat={}{0:0}°}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Ângulo" />
                                        </DockPanel>
                                        <Slider x:Name="GradientAngleSlider" Minimum="0" Maximum="360" TickFrequency="15" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Sombra" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <DockPanel Margin="0,3,0,13">
                                            <CheckBox x:Name="ShadowEnabledCheckBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Exibir sombra" />
                                            <TextBlock Text="Exibir sombra" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=ShadowOpacitySlider, Path=Value, StringFormat={}{0:P0}}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Opacidade" />
                                        </DockPanel>
                                        <Slider x:Name="ShadowOpacitySlider" Minimum="0" Maximum="1" TickFrequency="0.05" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=ShadowBlurSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Desfoque" />
                                        </DockPanel>
                                        <Slider x:Name="ShadowBlurSlider" Minimum="0" Maximum="40" TickFrequency="1" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=ShadowDepthSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Distância" />
                                        </DockPanel>
                                        <Slider x:Name="ShadowDepthSlider" Minimum="0" Maximum="20" TickFrequency="1" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Contorno" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <TextBlock Text="Cor da borda" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <DockPanel Margin="0,0,0,10">
                                            <Border x:Name="BorderColorPreview" DockPanel.Dock="Right" Width="40" Margin="8,0,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="#63636E" MouseLeftButtonDown="BorderColorPreview_Click" Cursor="Hand" ToolTip="Escolher cor" />
                                            <TextBox x:Name="BorderColorTextBox" Style="{StaticResource ModernTextBox}" TextChanged="BorderColorTextBox_TextChanged" />
                                        </DockPanel>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=BorderThicknessSlider, Path=Value, StringFormat={}{0:0.#} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Espessura" />
                                        </DockPanel>
                                        <Slider x:Name="BorderThicknessSlider" Minimum="0" Maximum="6" TickFrequency="0.5" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=CornerRadiusSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Arredondamento" />
                                        </DockPanel>
                                        <Slider x:Name="CornerRadiusSlider" Minimum="0" Maximum="40" TickFrequency="1" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ícones e espaçamento" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Tamanho dos ícones" />
                                        </DockPanel>
                                        <Slider x:Name="IconSizeSlider" Minimum="24" Maximum="128" TickFrequency="4" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=IconSpacingSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Entre ícones" />
                                        </DockPanel>
                                        <Slider x:Name="IconSpacingSlider" Minimum="0" Maximum="30" TickFrequency="1" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=DockPaddingHorizontalSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Margem interna horizontal" />
                                        </DockPanel>
                                        <Slider x:Name="DockPaddingHorizontalSlider" Minimum="0" Maximum="40" TickFrequency="2" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=DockPaddingVerticalSlider, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Margem interna vertical" />
                                        </DockPanel>
                                        <Slider x:Name="DockPaddingVerticalSlider" Minimum="0" Maximum="40" TickFrequency="2" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Movimento">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,6,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ao passar o mouse" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <TextBlock Text="Efeito" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="HoverMode" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                            <ComboBoxItem Tag="None" Content="Sem efeito" />
                                            <ComboBoxItem Tag="Zoom" Content="Ampliação" />
                                            <ComboBoxItem Tag="Wave" Content="Onda nos vizinhos" />
                                            <ComboBoxItem Tag="Glow" Content="Brilho" />
                                            <ComboBoxItem Tag="ZoomAndGlow" Content="Ampliação e brilho" />
                                        </ComboBox>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=HoverScaleSlider, Path=Value, StringFormat={}{0:P0}}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Ampliação" />
                                        </DockPanel>
                                        <Slider x:Name="HoverScaleSlider" Minimum="1" Maximum="2" TickFrequency="0.05" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                        <TextBlock Text="Cor do brilho" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <DockPanel>
                                            <Button Content="Escolher…" Click="PickAccent_Click" Width="85" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right" Margin="8,0,0,0" />
                                            <TextBox x:Name="AccentInput" Style="{StaticResource ModernTextBox}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Ao abrir um item" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <TextBlock Text="Animação de abertura" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="ClickMode" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                            <ComboBoxItem Tag="None" Content="Sem efeito" />
                                            <ComboBoxItem Tag="Bounce" Content="Salto" />
                                            <ComboBoxItem Tag="Pulse" Content="Pulso" />
                                            <ComboBoxItem Tag="Tilt" Content="Inclinação" />
                                        </ComboBox>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Em repouso" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=IdleSlider, Path=Value, StringFormat={}{0:P0}}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Opacidade da dock" />
                                        </DockPanel>
                                        <Slider x:Name="IdleSlider" Minimum="0.25" Maximum="1" TickFrequency="0.05" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Comportamento">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,16,6,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Posição na tela" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <TextBlock Text="Borda da tela" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="PositionComboBox" SelectedValuePath="Tag" Height="36" VerticalContentAlignment="Center" Margin="0,0,0,10">
                                            <ComboBoxItem Tag="Bottom" Content="Inferior" />
                                            <ComboBoxItem Tag="Top" Content="Superior" />
                                            <ComboBoxItem Tag="Left" Content="Esquerda" />
                                            <ComboBoxItem Tag="Right" Content="Direita" />
                                        </ComboBox>
                                        <DockPanel Margin="0,4,0,4">
                                            <TextBlock Text="{Binding ElementName=EdgeDistance, Path=Value, StringFormat={}{0:0} px}" DockPanel.Dock="Right" Foreground="#AFA2ED" />
                                            <TextBlock Text="Distância da borda" />
                                        </DockPanel>
                                        <Slider x:Name="EdgeDistance" Minimum="0" Maximum="100" TickFrequency="1" Style="{StaticResource ModernSlider}" Margin="0,0,0,8" IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Integração com o Windows" Style="{StaticResource SectionTitle}" Margin="0,0,0,14" />
                                        <DockPanel Margin="0,3,0,13">
                                            <CheckBox x:Name="StartWithWindowsCheckBox" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Iniciar com o Windows" />
                                            <TextBlock Text="Iniciar com o Windows" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3,0,13">
                                            <CheckBox x:Name="AlwaysOnTop" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Sempre no topo" />
                                            <TextBlock Text="Sempre no topo" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3,0,13">
                                            <CheckBox x:Name="ShowNames" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" AutomationProperties.Name="Mostrar nome ao passar o mouse" />
                                            <TextBlock Text="Mostrar nome ao passar o mouse" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <Border Grid.Row="2" BorderBrush="#34343D" BorderThickness="0,1,0,0" Padding="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Click="Cancel_Click" Width="104" Style="{StaticResource SecondaryButton}" IsCancel="True" Margin="0,0,8,0" />
                <Button Content="Salvar alterações" Width="150" Click="Save_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>