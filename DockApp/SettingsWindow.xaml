<Window x:Class="DockApp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configurações"
        Width="1080"
        SizeToContent="Height"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0C0E"
        Foreground="#F2F2F2"
        FontFamily="Segoe UI">

    <Window.Resources>

        <!-- ============================================================
             CORES / BRUSHES
             ============================================================ -->

        <SolidColorBrush x:Key="CardBrush" Color="#1A1C21"/>
        <SolidColorBrush x:Key="InputBrush" Color="#121417"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A2D34"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#30343B"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#969BA5"/>

        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B0C0E" Offset="0"/>
            <GradientStop Color="#15121C" Offset="0.5"/>
            <GradientStop Color="#0B0C0E" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#2563EB" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentGradientHoverBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#8B5CF6" Offset="0"/>
            <GradientStop Color="#3B82F6" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="AccentSolidBrush" Color="#7C3AED"/>
        <SolidColorBrush x:Key="IconTeal" Color="#22D3EE"/>
        <SolidColorBrush x:Key="IconPink" Color="#EC4899"/>
        <SolidColorBrush x:Key="IconBlue" Color="#3B82F6"/>

        <!-- Efeitos de glow do botão primário como recursos (evita nomear Effect dentro de Trigger) -->
        <DropShadowEffect x:Key="ButtonGlowOff" Color="#7C3AED" BlurRadius="0" ShadowDepth="0" Opacity="0.7"/>
        <DropShadowEffect x:Key="ButtonGlowOn" Color="#7C3AED" BlurRadius="20" ShadowDepth="0" Opacity="0.85"/>


        <!-- ============================================================
             ÍCONES (Segoe Fluent Icons / Segoe MDL2 Assets)
             ============================================================ -->

        <Style x:Key="IconGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>


        <!-- ============================================================
             TÍTULOS / TEXTOS
             ============================================================ -->

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>

        <Style x:Key="DescriptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>


        <!-- ============================================================
             TEXTBOX
             ============================================================ -->

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4F58"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- ============================================================
             THUMB DO SLIDER (bolinha com brilho, cresce no hover/clique)
             ============================================================ -->

        <Style x:Key="ModernSliderThumb" TargetType="Thumb">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid x:Name="ThumbRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Ellipse Fill="{StaticResource AccentGradientBrush}"
                                     Stroke="#FFFFFF"
                                     StrokeThickness="1.5">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#7C3AED" BlurRadius="10" ShadowDepth="0" Opacity="0.85"/>
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.3" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.3" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ThumbRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackFill" TargetType="RepeatButton">
            <Setter Property="Height" Value="6"/>
            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SliderTrackEmpty" TargetType="RepeatButton" BasedOn="{StaticResource SliderTrackFill}">
            <Setter Property="Background" Value="#24272D"/>
        </Style>

        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackFill}" Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderTrackEmpty}" Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernSliderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================================
             BOTÕES (com escala no clique e glow no hover)
             ============================================================ -->

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Background" Value="#25282D"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#363A42"
                                    BorderThickness="1"
                                    CornerRadius="9">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#2F333A"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="#4A4F58"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="22,0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="ButtonRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Grid.RenderTransform>
                            <Border x:Name="Bg"
                                    Background="{StaticResource AccentGradientBrush}"
                                    CornerRadius="9"
                                    Effect="{StaticResource ButtonGlowOff}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentGradientHoverBrush}"/>
                                <Setter TargetName="Bg" Property="Effect" Value="{StaticResource ButtonGlowOn}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="ButtonRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================================
             COMBOBOX
             ============================================================ -->

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="Background" Value="#191B1F"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="4,2">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#2E3239"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="#F2F2F2"/>
            <Setter Property="BorderBrush" Value="{StaticResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4A4F58"/>
                </Trigger>
                <Trigger Property="IsDropDownOpen" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentSolidBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- ============================================================
             TOGGLE SWITCH (substitui o CheckBox padrão)
             ============================================================ -->

        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="26" HorizontalAlignment="Left">
                            <Border x:Name="Track"
                                    CornerRadius="13"
                                    Background="#30343B"
                                    BorderBrush="#3E434C"
                                    BorderThickness="1"/>
                            <Border x:Name="Thumb"
                                    Width="20" Height="20"
                                    CornerRadius="10"
                                    Background="#C7CAD1"
                                    HorizontalAlignment="Left"
                                    Margin="3,0,0,0">
                                <Border.RenderTransform>
                                    <TranslateTransform X="0"/>
                                </Border.RenderTransform>
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="#565B65"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="20" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#7C3AED" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#FFFFFF" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Track" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#30343B" Duration="0:0:0.15"/>
                                            <ColorAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#C7CAD1" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!-- ============================================================
             CARD (borda que "acende" com a cor do tema ao passar o mouse)
             ============================================================ -->

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

    </Window.Resources>


    <!-- ================================================================
         FUNDO PRINCIPAL
         ================================================================ -->

    <Border Background="{StaticResource WindowBackgroundBrush}">

        <Grid Margin="28">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- ========================================================
                 CABEÇALHO
                 ======================================================== -->

            <StackPanel Grid.Row="0" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE713;" Style="{StaticResource IconGlyph}" FontSize="26" Foreground="{StaticResource AccentSolidBrush}" Margin="0,0,10,0"/>
                    <TextBlock Text="Configurações" FontSize="26" FontWeight="Bold" Foreground="#FFFFFF"/>
                </StackPanel>
                <TextBlock Text="Personalize a aparência e o comportamento da sua Dock."
                           FontSize="13"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="36,6,0,0"/>
            </StackPanel>


            <!-- ========================================================
                 CONTEÚDO HORIZONTAL
                 ======================================================== -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="1.25*"/>
                    <ColumnDefinition Width="1.05*"/>
                </Grid.ColumnDefinitions>


                <!-- ====================================================
                     CARD - ATALHOS
                     ==================================================== -->

                <Border Grid.Column="0" x:Name="CardAtalhos" Style="{StaticResource CardStyle}" Margin="0,0,8,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="ShadowAtalhos" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardAtalhos" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#22D3EE" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowAtalhos" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Border.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardAtalhos" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2D34" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowAtalhos" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE8B7;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource IconTeal}" Margin="0,0,8,0"/>
                            <TextBlock Text="Atalhos" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Escolha a pasta onde estão os atalhos que aparecerão na Dock."
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Pasta dos atalhos" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="FolderTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     IsReadOnly="True"/>

                            <Button Grid.Column="1"
                                    Width="105"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BrowseFolder_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8DA;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0"/>
                                    <TextBlock Text="Procurar"/>
                                </StackPanel>
                            </Button>

                        </Grid>

                    </StackPanel>

                </Border>


                <!-- ====================================================
                     CARD - APARÊNCIA
                     ==================================================== -->

                <Border Grid.Column="1" x:Name="CardAparencia" Style="{StaticResource CardStyle}" Margin="8,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="ShadowAparencia" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardAparencia" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#EC4899" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowAparencia" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Border.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardAparencia" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2D34" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowAparencia" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE790;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource IconPink}" Margin="0,0,8,0"/>
                            <TextBlock Text="Aparência" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Personalize o visual da Dock."
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,18"/>

                        <!-- COR DE FUNDO -->
                        <TextBlock Text="Cor de fundo" Style="{StaticResource FieldLabel}" Margin="0,0,0,7"/>

                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="ColorTextBox"
                                     Grid.Column="0"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="ColorTextBox_TextChanged"/>

                            <Border x:Name="ColorPreview"
                                    Grid.Column="1"
                                    Width="40" Height="40"
                                    Margin="8,0,0,0"
                                    Background="#202020"
                                    BorderBrush="#40444C"
                                    BorderThickness="1.4"
                                    CornerRadius="9"
                                    Cursor="Hand"
                                    MouseLeftButtonDown="ColorPreview_Click"
                                    ToolTip="Clique para escolher a cor"
                                    RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeftButtonDown">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="0:0:0.05" AutoReverse="True"/>
                                                <DoubleAnimation Storyboard.TargetName="ColorPreview" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="0:0:0.05" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>

                        </Grid>

                        <!-- TRANSPARÊNCIA -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Transparência" Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconTeal}"/>
                            </Border>
                        </Grid>

                        <Slider x:Name="OpacitySlider"
                                Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="1" TickFrequency="0.05"
                                ValueChanged="OpacitySlider_ValueChanged"
                                Margin="0,0,0,18"/>

                        <!-- ARREDONDAMENTO -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Arredondamento" Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                <TextBlock Text="{Binding ElementName=CornerRadiusSlider, Path=Value, StringFormat={}{0:0}}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconPink}"/>
                            </Border>
                        </Grid>

                        <Slider x:Name="CornerRadiusSlider"
                                Style="{StaticResource ModernSlider}"
                                Minimum="0" Maximum="40" TickFrequency="1"
                                Margin="0,0,0,18"/>

                        <!-- TAMANHO DOS ÍCONES -->
                        <Grid Margin="0,0,0,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tamanho dos ícones" Style="{StaticResource FieldLabel}"/>
                            <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                <TextBlock Text="{Binding ElementName=IconSizeSlider, Path=Value, StringFormat={}{0:0} px}"
                                           FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconBlue}"/>
                            </Border>
                        </Grid>

                        <Slider x:Name="IconSizeSlider"
                                Style="{StaticResource ModernSlider}"
                                Minimum="24" Maximum="128" TickFrequency="4"/>

                    </StackPanel>

                </Border>


                <!-- ====================================================
                     CARD - COMPORTAMENTO
                     ==================================================== -->

                <Border Grid.Column="2" x:Name="CardComportamento" Style="{StaticResource CardStyle}" Margin="8,0,0,0"
                        BorderBrush="{StaticResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect x:Name="ShadowComportamento" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
                    </Border.Effect>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardComportamento" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#3B82F6" Duration="0:0:0.15"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowComportamento" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Border.MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetName="CardComportamento" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2D34" Duration="0:0:0.2"/>
                                    <DoubleAnimation Storyboard.TargetName="ShadowComportamento" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="&#xE9F5;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource IconBlue}" Margin="0,0,8,0"/>
                            <TextBlock Text="Comportamento" Style="{StaticResource SectionTitle}"/>
                        </StackPanel>

                        <TextBlock Text="Defina como a Dock se comporta no Windows."
                                   Style="{StaticResource DescriptionText}"
                                   Margin="0,0,0,18"/>

                        <TextBlock Text="Posição da Dock" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                        <ComboBox x:Name="PositionComboBox"
                                  Style="{StaticResource ModernComboBox}"
                                  ItemContainerStyle="{StaticResource ModernComboBoxItem}"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="Inferior" Tag="Bottom"/>
                            <ComboBoxItem Content="Superior" Tag="Top"/>
                            <ComboBoxItem Content="Esquerda" Tag="Left"/>
                            <ComboBoxItem Content="Direita" Tag="Right"/>
                        </ComboBox>

                        <!-- INICIAR COM WINDOWS -->
                        <Border Background="{StaticResource InputBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Iniciar com o Windows" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="Inicia automaticamente o DockApp ao ligar o computador."
                                               Style="{StaticResource DescriptionText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="StartWithWindowsCheckBox"
                                          Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitch}"/>
                            </Grid>
                        </Border>

                    </StackPanel>

                </Border>

            </Grid>


            <!-- ========================================================
                 CARD - EFEITOS AVANÇADOS (borda, sombra, degradê, espaçamento)
                 ======================================================== -->

            <Border Grid.Row="2" x:Name="CardEfeitos" Style="{StaticResource CardStyle}" Margin="0,16,0,0"
                    BorderBrush="{StaticResource BorderBrush}">
                <Border.Effect>
                    <DropShadowEffect x:Name="ShadowEfeitos" Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.45"/>
                </Border.Effect>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.MouseEnter">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardEfeitos" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#7C3AED" Duration="0:0:0.15"/>
                                <DoubleAnimation Storyboard.TargetName="ShadowEfeitos" Storyboard.TargetProperty="BlurRadius" To="26" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Border.MouseLeave">
                        <BeginStoryboard>
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="CardEfeitos" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#2A2D34" Duration="0:0:0.2"/>
                                <DoubleAnimation Storyboard.TargetName="ShadowEfeitos" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>

                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="&#xE771;" Style="{StaticResource IconGlyph}" Foreground="{StaticResource AccentSolidBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="Efeitos avançados" Style="{StaticResource SectionTitle}"/>
                    </StackPanel>

                    <TextBlock Text="Ajuste borda, sombra, degradê e espaçamento da Dock."
                               Style="{StaticResource DescriptionText}"
                               Margin="0,0,0,18"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- COLUNA 1: BORDA -->
                        <StackPanel Grid.Column="0">

                            <TextBlock Text="Borda" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="BorderColorTextBox"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="BorderColorTextBox_TextChanged"/>

                                <Border x:Name="BorderColorPreview"
                                        Grid.Column="1"
                                        Width="40" Height="40"
                                        Margin="8,0,0,0"
                                        Background="#404040"
                                        BorderBrush="#40444C"
                                        BorderThickness="1.4"
                                        CornerRadius="9"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="BorderColorPreview_Click"
                                        ToolTip="Clique para escolher a cor"/>

                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Espessura" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=BorderThicknessSlider, Path=Value, StringFormat={}{0:0.#} px}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconTeal}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="BorderThicknessSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="6" TickFrequency="0.5"/>

                        </StackPanel>

                        <!-- COLUNA 2: SOMBRA -->
                        <StackPanel Grid.Column="2">

                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Sombra" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="ShadowEnabledCheckBox"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Opacidade" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=ShadowOpacitySlider, Path=Value, StringFormat={}{0:P0}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconTeal}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="ShadowOpacitySlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="1" TickFrequency="0.05"
                                    Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Desfoque" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=ShadowBlurSlider, Path=Value, StringFormat={}{0:0}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconTeal}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="ShadowBlurSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="40" TickFrequency="1"
                                    Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Distância" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=ShadowDepthSlider, Path=Value, StringFormat={}{0:0}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconTeal}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="ShadowDepthSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="20" TickFrequency="1"/>

                        </StackPanel>

                        <!-- COLUNA 3: DEGRADÊ -->
                        <StackPanel Grid.Column="4">

                            <Border Background="{StaticResource InputBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="12"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Degradê" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <CheckBox x:Name="UseGradientCheckBox"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ToggleSwitch}"/>
                                </Grid>
                            </Border>

                            <TextBlock Text="Segunda cor" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="ColorTextBox2"
                                         Grid.Column="0"
                                         Style="{StaticResource ModernTextBox}"
                                         TextChanged="ColorTextBox2_TextChanged"/>

                                <Border x:Name="ColorPreview2"
                                        Grid.Column="1"
                                        Width="40" Height="40"
                                        Margin="8,0,0,0"
                                        Background="#101010"
                                        BorderBrush="#40444C"
                                        BorderThickness="1.4"
                                        CornerRadius="9"
                                        Cursor="Hand"
                                        MouseLeftButtonDown="ColorPreview2_Click"
                                        ToolTip="Clique para escolher a cor"/>

                            </Grid>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Ângulo" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=GradientAngleSlider, Path=Value, StringFormat={}{0:0}°}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconPink}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="GradientAngleSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="360" TickFrequency="15"/>

                        </StackPanel>

                        <!-- COLUNA 4: ESPAÇAMENTO -->
                        <StackPanel Grid.Column="6">

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Padding horizontal" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=DockPaddingHorizontalSlider, Path=Value, StringFormat={}{0:0} px}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconBlue}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="DockPaddingHorizontalSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="40" TickFrequency="2"
                                    Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Padding vertical" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=DockPaddingVerticalSlider, Path=Value, StringFormat={}{0:0} px}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconBlue}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="DockPaddingVerticalSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="40" TickFrequency="2"
                                    Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Espaço entre ícones" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=IconSpacingSlider, Path=Value, StringFormat={}{0:0} px}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconBlue}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="IconSpacingSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="0" Maximum="30" TickFrequency="1"
                                    Margin="0,0,0,14"/>

                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Zoom no hover" Style="{StaticResource FieldLabel}"/>
                                <Border Grid.Column="1" Background="#20222A" CornerRadius="5" Padding="8,2">
                                    <TextBlock Text="{Binding ElementName=HoverScaleSlider, Path=Value, StringFormat={}{0:0%}}"
                                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource IconBlue}"/>
                                </Border>
                            </Grid>

                            <Slider x:Name="HoverScaleSlider"
                                    Style="{StaticResource ModernSlider}"
                                    Minimum="1" Maximum="2" TickFrequency="0.05"/>

                        </StackPanel>

                    </Grid>

                </StackPanel>

            </Border>


            <!-- ========================================================
                 RODAPÉ
                 ======================================================== -->

            <Border Grid.Row="3" Margin="0,22,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">

                    <Button Width="110" Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Cancelar"/>
                        </StackPanel>
                    </Button>

                    <Button Width="170"
                            Style="{StaticResource PrimaryButton}"
                            Click="Save_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" Style="{StaticResource IconGlyph}" FontSize="14" Margin="0,0,6,0" Foreground="White"/>
                            <TextBlock Text="Salvar alterações"/>
                        </StackPanel>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>

    </Border>

</Window>